{
  "openapi": "3.0.3",
  "info": {
    "title": "Swagger Beeline EA Capability - OpenAPI 3.0",
    "description": "Интерфейс для управления моделью возможностей в корпоративном архитектурном репозитории Sparx EA",
    "contact": {
      "email": "ivvoronin@beeline.ru"
    },
    "version": "0.0.2"
  },
  "tags": [
    {
      "name": "Управление доменами",
      "description": "Методы для получения, добавления и изменения описаний доменов возможностей"
    },
    {
      "name": "Управление возможностями",
      "description": "Методы получения, добавления и изменения описания возможностей"
    },
    {
      "name": "Управление интерфейсами",
      "description": "Методы получения, добавления и изменения описания интерфейсов"
    },
    {
      "name": "Управление компонентами",
      "description": "Управление описанием компонентов"
    },
    {
      "name": "Управление реализацией возможностей",
      "description": "Управление описанием вариантов реализации возможности"
    }
  ],
  "servers": [
    {
      "url": "../..",
      "description": "Локальный сервер"
    }
  ],
  "paths": {
    "/api/domains": {
      "get": {
        "tags": [
          "Управление доменами"
        ],
        "x-swagger-router-controller": "DomainsController",
        "operationId": "getDomains",
        "summary": "Получение списка доменов",
        "description": "Получение списка доменов верхнево уровня или всех в виде списка",
        "parameters": [
          {
            "name": "all",
            "description": "- true - Получить все домены плоским списком\n- false или отсутствует - Получить список доменов верхнего уровня",
            "in": "query",
            "required": false,
            "allowEmptyValue": true,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "example": "false"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Domain"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Управление доменами"
        ],
        "x-swagger-router-controller": "DomainsController",
        "operationId": "createDomain",
        "summary": "Регистрация нового домена",
        "description": "Добавляет в корпоративный репозиторий описание нового домена\\\nКаждый новый домен добавлется как поддомен, если указан родитель (поле parent). \\\nПри добавлении домена сохраняются следующие поля:\n- code, name, description, status, author\n- Если указан parent, то домен добавляется как поддомен указанного в этом поле домена. В противном случае добавлявется в корень",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Domain"
              },
              "examples": {
                "PostDomain": {
                  "$ref": "#/components/examples/PostDomain"
                },
                "PostDomain2": {
                  "$ref": "#/components/examples/PostDomain2"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Domain"
                }
              }
            }
          },
          "400": {
            "description": "Не корректный синтаксис запроса",
            "content": {
              "application/json": {
                "examples": {
                  "PostDomainCodeNotSetResponse": {
                    "$ref": "#/components/examples/PostDomainCodeNotSetResponse"
                  }
                }
              }
            }
          },
          "424": {
            "description": "Не верно указан родительский домен"
          }
        }
      }
    },
    "/api/domains/{code}": {
      "get": {
        "x-swagger-router-controller": "DomainsController",
        "tags": [
          "Управление доменами"
        ],
        "summary": "Получение описания домена по его коду",
        "operationId": "getDomainByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Код запрашиваемого домена",
            "examples": {
              "200": {
                "value": "GRP.010"
              },
              "404": {
                "value": "WRONG"
              }
            },
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/Domain"
                },
                "example": {
                  "code": "GRP.010",
                  "href": "/api/domains/GRP.010",
                  "name": "Управление ИТ",
                  "description": null,
                  "createdDate": "2021-04-16T00:00:00.000Z",
                  "modifiedDate": "2022-10-17T14:52:03.000Z",
                  "author": "vkit",
                  "status": "Proposed",
                  "parent": {
                    "code": "GRP.000",
                    "href": "/api/domains/GRP.000"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Домен с указанным кодом не найден",
            "content": {
              "application/json": {
                "examples": {
                  "WrongDomainResponse": {
                    "$ref": "#/components/examples/WrongDomainResponse"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Управление доменами"
        ],
        "summary": "Обновление данных для домена",
        "description": "При добавлении домена сохраняются следующие поля:\\\n- name, description, status",
        "x-swagger-router-controller": "DomainsController",
        "operationId": "updateDomain",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Код домена",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "GRP.TEST.001"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Domain"
              },
              "examples": {
                "success": {
                  "value": {
                    "name": "Новое имя",
                    "description": "Добавленное описание",
                    "status": "Approved"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Обновление прошло успешно\\\nВ ответе возвращается обновленное описание домена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Domain"
                }
              }
            }
          },
          "404": {
            "description": "Домен с указанным кодом не найден"
          }
        }
      }
    },

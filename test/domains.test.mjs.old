process.env.NODE_ENV = 'test';

import env from '../src/env.mjs'
import request from 'supertest'
import app from '../src/load-app.mjs'
import { GET_DOMAINS_RESPONSE, GRP_009_SUBDOMAINS_RESPONSE, DMN_045_CAPABILITIES, WRONG_DOMAIN_RESPONSE } from './data/domain-data.mjs'


//#region тестовые данные


const CREATE_ROOT_GROUP = {
  "code": "GRP.TEST.001",
  "name": "Тестовая группа в корне",
  "description": "Домен для теста создания группы доменов",
  "status": "Тестовый",
  "author": "OSLC-API",
}

const CREATE_SUBDOMAIN = {
  "code": "DMN.TEST.001",
  "name": "Тестовый домен",
  "description": "Тестовый домен",
  "status": "Тестовый",
  "author": "OSLC-API",
  "parent": {
    "code": "GRP.TEST.000"
  }
}



//#endregion

describe("/api/domains", () => {
  before(() => {
    //env.config();
    //app.listen( 3005)
  })

  it("GET /api/domains", function (done) {
    request(app)
      .get('/api/domains')
      .expect(200)
      .expect('Content-Type', /application\/json/)
      .expect(GET_DOMAINS_RESPONSE)
      .end(done);
  });

  it("GET /api/domains/{code}", function (done) {
    request(app)
      .get('/api/domains/GRP.010')
      .expect(200)
      .expect('Content-Type', /application\/json/)
      .expect({
        code: 'GRP.010',
        href: '/api/domains/GRP.010',
        name: 'Управление ИТ',
        description: null,
        createdDate: '2021-04-15T21:00:00.000Z',
        modifiedDate: '2022-10-17T11:52:03.000Z',
        author: 'vkit',
        status: 'Proposed',
        parent: { code: 'GRP.000', href: '/api/domains/GRP.000' }
      })
      .end(done);
  });
  it("GET /api/domains/{code} - wrong domain code", function (done) {
    request(app)
      .get('/api/domains/GRP.010-wrong')
      .expect(404)
      .expect('Content-Type', /application\/json/)
      .expect(WRONG_DOMAIN_RESPONSE)
      .end(done);
  });
  it("GET /api/domains/{code}/subdomains", function (done) {

    request(app)
      .get('/api/domains/GRP.009/subdomains')
      .expect(200)
      .expect('Content-Type', /application\/json/)
      .expect(GRP_009_SUBDOMAINS_RESPONSE)
      .end(done);
  });

  it("GET /api/domains/{code}/capabilities", function (done) {

    request(app)
      .get('/api/domains/DMN.042/capabilities')
      .expect(200)
      .expect('Content-Type', /application\/json/)
      .expect(DMN_045_CAPABILITIES)
      .end(done);
  });

  it("POST /api/domains", function (done) {

    request(app)
      .post('/api/domains')
      .send(CREATE_ROOT_GROUP)
      .expect(200)
      .expect('Content-Type', /application\/json/)
      .expect({})
      .end(done);
  });

})

